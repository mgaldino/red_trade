{"type":"item.completed","item":{"id":"item_37","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,280p' /Users/manoelgaldino/.codex/skills/adjudicate-review/scripts/validate_adjudication.py && printf '\\\\n--- baseline manifest ---\\\\n' && sed -n '1,220p' reports/refine_ink_review_paper_v4_2026-09-14/execution/baseline_manifest.json && printf '\\\\n--- current Git status (read-only) ---\\\\n' && git status --short --untracked-files=all | sed -n '1,180p'\"","aggregated_output":"#!/usr/bin/env python3\n\"\"\"Validate an evidence-backed review adjudication record.\"\"\"\n\nfrom __future__ import annotations\n\nimport argparse\nimport hashlib\nimport json\nimport re\nimport sys\nfrom collections import Counter\nfrom pathlib import Path\nfrom typing import Any\n\n\nSHA256_RE = re.compile(r\"^[0-9a-f]{64}$\")\nSTATUSES = {\"CONFIRMED\", \"PARTIAL\", \"REFUTED\", \"UNRESOLVED\"}\nFIX_ASSESSMENTS = {\"safe\", \"unsafe\", \"owner_decision\", \"not_provided\", \"needs_design\"}\nVERDICTS = {\"READY_FOR_IMPLEMENTATION\", \"NO_CONFIRMED_DEFECTS\", \"BLOCKED\"}\n\n\ndef sha256_file(path: Path) -> str:\n    digest = hashlib.sha256()\n    with path.open(\"rb\") as handle:\n        for chunk in iter(lambda: handle.read(1024 * 1024), b\"\"):\n            digest.update(chunk)\n    return digest.hexdigest()\n\n\ndef nonempty(value: Any) -> bool:\n    return value is not None and value != \"\" and value != [] and value != {}\n\n\ndef require_keys(obj: Any, keys: set[str], where: str, errors: list[str]) -> None:\n    if not isinstance(obj, dict):\n        errors.append(f\"{where} must be an object\")\n        return\n    for key in sorted(keys - set(obj)):\n        errors.append(f\"missing {where}.{key}\")\n\n\ndef valid_sha(value: Any) -> bool:\n    return isinstance(value, str) and bool(SHA256_RE.fullmatch(value))\n\n\ndef validate(data: Any, artifact: Path | None, contract_file: Path | None) -> list[str]:\n    errors: list[str] = []\n    require_keys(data, {\"schema_version\", \"adjudication_id\", \"source\", \"contract\", \"review_sources\", \"findings\", \"summary\", \"adjudication\"}, \"root\", errors)\n    if not isinstance(data, dict):\n        return errors\n    if data.get(\"schema_version\") != \"1.0\":\n        errors.append(\"schema_version must be 1.0\")\n    if not nonempty(data.get(\"adjudication_id\")):\n        errors.append(\"adjudication_id must be non-empty\")\n\n    source = data.get(\"source\", {})\n    require_keys(source, {\"reviewed_artifact\", \"sha256\", \"artifact_intact\"}, \"source\", errors)\n    source_hash = source.get(\"sha256\") if isinstance(source, dict) else None\n    if not valid_sha(source_hash):\n        errors.append(\"source.sha256 must be 64 lowercase hex characters\")\n    if artifact is not None:\n        if not artifact.is_file():\n            errors.append(f\"artifact does not exist: {artifact}\")\n        elif valid_sha(source_hash) and sha256_file(artifact) != source_hash:\n            errors.append(\"artifact hash does not match source.sha256\")\n\n    contract = data.get(\"contract\", {})\n    require_keys(contract, {\"required\", \"path\", \"sha256\", \"contract_id\", \"artifact_sha256\", \"status\", \"stale\"}, \"contract\", errors)\n    contract_blocked = False\n    if isinstance(contract, dict):\n        required = contract.get(\"required\")\n        if not isinstance(required, bool):\n            errors.append(\"contract.required must be boolean\")\n        if not isinstance(contract.get(\"stale\"), bool):\n            errors.append(\"contract.stale must be boolean\")\n        if required:\n            if not nonempty(contract.get(\"path\")) or not nonempty(contract.get(\"contract_id\")):\n                errors.append(\"required contract needs path and contract_id\")\n            if not valid_sha(contract.get(\"sha256\")):\n                errors.append(\"required contract.sha256 is invalid\")\n            if contract.get(\"status\") != \"PASS\":\n                errors.append(\"required contract must have PASS status\")\n            if not valid_sha(contract.get(\"artifact_sha256\")):\n                errors.append(\"required contract.artifact_sha256 is invalid\")\n            elif valid_sha(source_hash) and contract.get(\"artifact_sha256\") != source_hash:\n                errors.append(\"contract artifact hash does not match source hash\")\n            contract_blocked = contract.get(\"stale\") is True or contract.get(\"status\") != \"PASS\"\n            if contract_file is None:\n                errors.append(\"required contract needs --contract-file verification\")\n            elif not contract_file.is_file():\n                errors.append(f\"contract file does not exist: {contract_file}\")\n            else:\n                if valid_sha(contract.get(\"sha256\")) and sha256_file(contract_file) != contract.get(\"sha256\"):\n                    errors.append(\"contract file hash does not match contract.sha256\")\n                try:\n                    actual_contract = json.loads(contract_file.read_text(encoding=\"utf-8\"))\n                except (OSError, json.JSONDecodeError) as exc:\n                    errors.append(f\"cannot parse contract file: {exc}\")\n                else:\n                    if actual_contract.get(\"contract_id\") != contract.get(\"contract_id\"):\n                        errors.append(\"contract_id does not match the verified contract file\")\n                    if actual_contract.get(\"source\", {}).get(\"sha256\") != contract.get(\"artifact_sha256\"):\n                        errors.append(\"contract artifact_sha256 does not match the verified contract file\")\n                    if actual_contract.get(\"gate\", {}).get(\"status\") != contract.get(\"status\"):\n                        errors.append(\"contract status does not match the verified contract file\")\n        else:\n            for key in (\"path\", \"sha256\", \"contract_id\", \"artifact_sha256\", \"status\"):\n                if contract.get(key) is not None:\n                    errors.append(f\"optional contract.{key} must be null\")\n\n    reviews = data.get(\"review_sources\")\n    if not isinstance(reviews, list) or not reviews:\n        errors.append(\"review_sources must be a non-empty list\")\n    else:\n        for index, review in enumerate(reviews):\n            require_keys(review, {\"review_id\", \"path\", \"sha256\"}, f\"review_sources[{index}]\", errors)\n            if isinstance(review, dict) and not valid_sha(review.get(\"sha256\")):\n                errors.append(f\"review_sources[{index}].sha256 is invalid\")\n\n    findings = data.get(\"findings\")\n    counts: Counter[str] = Counter()\n    held_count = 0\n    if not isinstance(findings, list):\n        errors.append(\"findings must be a list\")\n        findings = []\n    seen_ids: set[str] = set()\n    required_finding = {\"finding_id\", \"source_review\", \"quoted_finding\", \"type\", \"severity\", \"scientific_dimension\", \"held_decision\", \"status\", \"source_locations\", \"defect_evidence\", \"refuting_evidence\", \"mechanical_checks\", \"reasoning\", \"proposed_fix_assessment\", \"disposition\"}\n    for index, finding in enumerate(findings):\n        require_keys(finding, required_finding, f\"findings[{index}]\", errors)\n        if not isinstance(finding, dict):\n            continue\n        finding_id = finding.get(\"finding_id\")\n        if not nonempty(finding_id):\n            errors.append(f\"findings[{index}].finding_id must be non-empty\")\n        elif finding_id in seen_ids:\n            errors.append(f\"duplicate finding_id: {finding_id}\")\n        seen_ids.add(finding_id)\n        status = finding.get(\"status\")\n        if status not in STATUSES:\n            errors.append(f\"findings[{index}].status is invalid\")\n        else:\n            counts[status] += 1\n        if not isinstance(finding.get(\"held_decision\"), bool):\n            errors.append(f\"findings[{index}].held_decision must be boolean\")\n        elif finding.get(\"held_decision\"):\n            held_count += 1\n        if not isinstance(finding.get(\"source_locations\"), list) or not finding.get(\"source_locations\"):\n            errors.append(f\"findings[{index}].source_locations must be non-empty\")\n        for key in (\"defect_evidence\", \"refuting_evidence\", \"mechanical_checks\"):\n            if not isinstance(finding.get(key), list):\n                errors.append(f\"findings[{index}].{key} must be a list\")\n        if not nonempty(finding.get(\"reasoning\")):\n            errors.append(f\"findings[{index}].reasoning must be non-empty\")\n        if finding.get(\"proposed_fix_assessment\") not in FIX_ASSESSMENTS:\n            errors.append(f\"findings[{index}].proposed_fix_assessment is invalid\")\n        if status == \"CONFIRMED\" and not finding.get(\"defect_evidence\"):\n            errors.append(f\"findings[{index}] CONFIRMED requires defect_evidence\")\n        if status == \"REFUTED\" and not finding.get(\"refuting_evidence\"):\n            errors.append(f\"findings[{index}] REFUTED requires refuting_evidence\")\n        if status == \"PARTIAL\" and (not finding.get(\"defect_evidence\") or not finding.get(\"refuting_evidence\")):\n            errors.append(f\"findings[{index}] PARTIAL requires defect_evidence and refuting_evidence\")\n\n    summary = data.get(\"summary\", {})\n    require_keys(summary, {\"total\", \"confirmed\", \"partial\", \"refuted\", \"unresolved\", \"held_decisions\"}, \"summary\", errors)\n    if isinstance(summary, dict):\n        expected = {\n            \"total\": len(findings),\n            \"confirmed\": counts[\"CONFIRMED\"],\n            \"partial\": counts[\"PARTIAL\"],\n            \"refuted\": counts[\"REFUTED\"],\n            \"unresolved\": counts[\"UNRESOLVED\"],\n            \"held_decisions\": held_count,\n        }\n        for key, value in expected.items():\n            if summary.get(key) != value:\n                errors.append(f\"summary.{key} must equal {value}\")\n\n    adjudication = data.get(\"adjudication\", {})\n    require_keys(adjudication, {\"verdict\", \"checked_at\", \"reasons\"}, \"adjudication\", errors)\n    if isinstance(adjudication, dict):\n        verdict = adjudication.get(\"verdict\")\n        if verdict not in VERDICTS:\n            errors.append(\"adjudication.verdict is invalid\")\n        if not isinstance(adjudication.get(\"reasons\"), list) or not adjudication.get(\"reasons\"):\n            errors.append(\"adjudication.reasons must be a non-empty list\")\n        has_defects = counts[\"CONFIRMED\"] + counts[\"PARTIAL\"] > 0\n        has_unresolved = counts[\"UNRESOLVED\"] > 0\n        artifact_intact = source.get(\"artifact_intact\") is True if isinstance(source, dict) else False\n        if verdict == \"READY_FOR_IMPLEMENTATION\" and (not has_defects or has_unresolved or contract_blocked or not artifact_intact):\n            errors.append(\"READY_FOR_IMPLEMENTATION requires defects, intact/current inputs, and no unresolved findings\")\n        if verdict == \"NO_CONFIRMED_DEFECTS\" and (has_defects or has_unresolved or contract_blocked or not artifact_intact):\n            errors.append(\"NO_CONFIRMED_DEFECTS requires no defects, no unresolved findings, and intact/current inputs\")\n        if (contract_blocked or not artifact_intact or has_unresolved) and verdict != \"BLOCKED\":\n            errors.append(\"stale/broken inputs or unresolved findings require BLOCKED\")\n    return errors\n\n\ndef main() -> int:\n    parser = argparse.ArgumentParser(description=__doc__)\n    parser.add_argument(\"record\", type=Path)\n    parser.add_argument(\"--artifact\", type=Path, required=True)\n    parser.add_argument(\"--contract-file\", type=Path)\n    args = parser.parse_args()\n    try:\n        data = json.loads(args.record.read_text(encoding=\"utf-8\"))\n    except (OSError, json.JSONDecodeError) as exc:\n        print(f\"INVALID: {exc}\", file=sys.stderr)\n        return 1\n    errors = validate(data, args.artifact, args.contract_file)\n    if errors:\n        for error in errors:\n            print(f\"INVALID: {error}\", file=sys.stderr)\n        return 1\n    print(f\"VALID: {args.record}\")\n    return 0\n\n\nif __name__ == \"__main__\":\n    raise SystemExit(main())\n\n--- baseline manifest ---\n{\n  \"date\": \"2026-09-14T13:22:34.722033\",\n  \"head\": \"a04548104383e3cdbe9ceefc18015a7c475ce668\",\n  \"status_before\": \"?? reports/refine_ink_review_paper_v4_2026-09-14/execution/\\n\",\n  \"sha256\": {\n    \"paper_v4.Rmd\": \"9c6b03ed3d3703e4a76eb6f35c43201afb08f0479266a1c08b60008e34ff13b4\",\n    \"output/paper_v4.pdf\": \"da7b84fd44a1071953c5c2941be53aefb75f2b249476cc2d6e065e5f8463e312\"\n  }\n}\n\n--- current Git status (read-only) ---\n M reports/refine_ink_review_paper_v4_2026-09-14/execution/corpus_votes_bibliography_events.jsonl\n M reports/refine_ink_review_paper_v4_2026-09-14/execution/corpus_votes_bibliography_stderr.log\n M reports/refine_ink_review_paper_v4_2026-09-14/execution/domain_note_events.jsonl\n M reports/refine_ink_review_paper_v4_2026-09-14/execution/domain_note_stderr.log\n M reports/refine_ink_review_paper_v4_2026-09-14/execution/local_fixes_events.jsonl\n M reports/refine_ink_review_paper_v4_2026-09-14/execution/prompts/bibliography_xhigh.txt\n?? reports/refine_ink_review_paper_v4_2026-09-14/execution/bibliography_xhigh_events.jsonl\n?? reports/refine_ink_review_paper_v4_2026-09-14/execution/bibliography_xhigh_stderr.log\n?? reports/refine_ink_review_paper_v4_2026-09-14/execution/candidate_workspace.json\n?? reports/refine_ink_review_paper_v4_2026-09-14/execution/domain_note_final.txt\n","exit_code":0,"status":"completed"}}
