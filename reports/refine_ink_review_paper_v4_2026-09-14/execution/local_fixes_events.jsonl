{"type":"item.completed","item":{"id":"item_45","type":"command_execution","command":"/bin/zsh -lc \"printf '%s\\\\n' '--- status-current helpers and panel filter ---' && rg -n '\"'^build_status_current_period_data|''^make_status_current_panel|''^summarize_status_current_units|''^count_status_current_sample|''^min_int_or_na'\"' scripts/functions.R && for sym in build_status_current_period_data make_status_current_panel summarize_status_current_units count_status_current_sample; do line=\"'$(rg -n \"''^${sym} <- function\" scripts/functions.R | cut -d: -f1); end=$((line+170)); echo \"### ${sym} (${line})\"; nl -ba scripts/functions.R | sed -n \"${line},${end}p\"; done'","aggregated_output":"--- status-current helpers and panel filter ---\n4013:min_int_or_na <- function(x) {\n4119:build_status_current_period_data <- function(panel,\n4268:make_status_current_panel <- function(period_data,\n4367:count_status_current_sample <- function(panel, label) {\n4407:summarize_status_current_units <- function(panel, label) {\n4427:make_status_current_panel_bundle <- function(panel,\n### build_status_current_period_data (4119)\n  4119\tbuild_status_current_period_data <- function(panel,\n  4120\t                                             min_duration_years = 5L,\n  4121\t                                             min_entry_year = 2000L) {\n  4122\t  required_cols <- c(\"iso3c\", \"year\", \"abs_distance_china\", \"china_top\")\n  4123\t  missing_cols <- setdiff(required_cols, names(panel))\n  4124\t  if (length(missing_cols) > 0L) {\n  4125\t    stop(\"Missing required columns: \", paste(missing_cols, collapse = \", \"),\n  4126\t         call. = FALSE)\n  4127\t  }\n  4128\t\n  4129\t  optional_cols <- intersect(\n  4130\t    c(\"country_id\", \"country_name\", \"top_partner\", \"china_is_top\",\n  4131\t      \"rank_CHN\", \"rank_USA\"),\n  4132\t    names(panel)\n  4133\t  )\n  4134\t\n  4135\t  # Durability thresholds are defined over country-years observed in both the\n  4136\t  # trade-rank panel and the outcome panel used by the estimator.\n  4137\t  base_panel <- panel |>\n  4138\t    dplyr::select(dplyr::all_of(unique(c(required_cols, optional_cols)))) |>\n  4139\t    dplyr::filter(dplyr::if_all(dplyr::all_of(required_cols), ~ !is.na(.x))) |>\n  4140\t    dplyr::arrange(iso3c, year)\n  4141\t\n  4142\t  if (\"top_partner\" %in% names(base_panel)) {\n  4143\t    base_panel <- base_panel |>\n  4144\t      dplyr::filter(!is.na(top_partner)) |>\n  4145\t      dplyr::mutate(china_top_observed = top_partner == \"CHN\")\n  4146\t  } else if (\"china_is_top\" %in% names(base_panel)) {\n  4147\t    base_panel <- base_panel |>\n  4148\t      dplyr::mutate(china_top_observed = dplyr::coalesce(china_is_top, FALSE))\n  4149\t  } else {\n  4150\t    base_panel <- base_panel |>\n  4151\t      dplyr::mutate(china_top_observed = china_top == 1L)\n  4152\t  }\n  4153\t\n  4154\t  if (!\"country_name\" %in% names(base_panel)) {\n  4155\t    base_panel <- base_panel |>\n  4156\t      dplyr::mutate(\n  4157\t        country_name = countrycode::countrycode(\n  4158\t          iso3c,\n  4159\t          \"iso3c\",\n  4160\t          \"country.name\",\n  4161\t          warn = FALSE\n  4162\t        )\n  4163\t      )\n  4164\t  }\n  4165\t\n  4166\t  period_panel <- base_panel |>\n  4167\t    dplyr::group_by(iso3c) |>\n  4168\t    dplyr::arrange(year, .by_group = TRUE) |>\n  4169\t    dplyr::mutate(\n  4170\t      china_top_eligible = as.integer(china_top == 1L),\n  4171\t      eligible_period_start = china_top_eligible == 1L &\n  4172\t        dplyr::lag(china_top_eligible, default = 0L) == 0L,\n  4173\t      eligible_period_id_raw = cumsum(eligible_period_start),\n  4174\t      eligible_period_id = dplyr::if_else(\n  4175\t        china_top_eligible == 1L,\n  4176\t        eligible_period_id_raw,\n  4177\t        NA_integer_\n  4178\t      )\n  4179\t    ) |>\n  4180\t    dplyr::ungroup()\n  4181\t\n  4182\t  period_summary <- period_panel |>\n  4183\t    dplyr::filter(china_top_eligible == 1L, !is.na(eligible_period_id)) |>\n  4184\t    dplyr::group_by(iso3c, country_name, eligible_period_id) |>\n  4185\t    dplyr::summarise(\n  4186\t      period_entry_year = min(year, na.rm = TRUE),\n  4187\t      period_exit_year = max(year, na.rm = TRUE),\n  4188\t      duration_years = dplyr::n_distinct(year),\n  4189\t      calendar_span_years = period_exit_year - period_entry_year + 1L,\n  4190\t      .groups = \"drop\"\n  4191\t    ) |>\n  4192\t    dplyr::mutate(\n  4193\t      qualifies_min5 = period_entry_year >= min_entry_year &\n  4194\t        duration_years >= min_duration_years,\n  4195\t      qualifies_min_duration = qualifies_min5\n  4196\t    )\n  4197\t\n  4198\t  qualifying_periods <- period_summary |>\n  4199\t    dplyr::filter(qualifies_min5) |>\n  4200\t    dplyr::select(iso3c, eligible_period_id)\n  4201\t\n  4202\t  unit_summary <- period_panel |>\n  4203\t    dplyr::group_by(iso3c, country_name) |>\n  4204\t    dplyr::summarise(\n  4205\t      ever_china_top_observed = any(china_top_observed, na.rm = TRUE),\n  4206\t      first_observed_year = min(year, na.rm = TRUE),\n  4207\t      last_observed_year = max(year, na.rm = TRUE),\n  4208\t      .groups = \"drop\"\n  4209\t    ) |>\n  4210\t    dplyr::left_join(\n  4211\t      period_summary |>\n  4212\t        dplyr::group_by(iso3c) |>\n  4213\t        dplyr::summarise(\n  4214\t          eligible_periods = dplyr::n(),\n  4215\t          qualifying_periods = sum(qualifies_min5, na.rm = TRUE),\n  4216\t          first_eligible_entry = ifelse(\n  4217\t            dplyr::n() > 0L,\n  4218\t            min(period_entry_year, na.rm = TRUE),\n  4219\t            NA_integer_\n  4220\t          ),\n  4221\t          first_qualifying_entry = ifelse(\n  4222\t            any(qualifies_min5, na.rm = TRUE),\n  4223\t            min(period_entry_year[qualifies_min5], na.rm = TRUE),\n  4224\t            NA_integer_\n  4225\t          ),\n  4226\t          max_eligible_duration = ifelse(\n  4227\t            dplyr::n() > 0L,\n  4228\t            max(duration_years, na.rm = TRUE),\n  4229\t            0L\n  4230\t          ),\n  4231\t          total_eligible_china_top_years = sum(duration_years, na.rm = TRUE),\n  4232\t          total_qualifying_china_top_years = sum(\n  4233\t            duration_years[qualifies_min5],\n  4234\t            na.rm = TRUE\n  4235\t          ),\n  4236\t          .groups = \"drop\"\n  4237\t        ),\n  4238\t      by = \"iso3c\"\n  4239\t    ) |>\n  4240\t    dplyr::mutate(\n  4241\t      dplyr::across(\n  4242\t        c(eligible_periods, qualifying_periods, max_eligible_duration,\n  4243\t          total_eligible_china_top_years, total_qualifying_china_top_years),\n  4244\t        ~ dplyr::coalesce(.x, 0)\n  4245\t      ),\n  4246\t      cs_role_min5 = dplyr::case_when(\n  4247\t        qualifying_periods > 0L ~ \"treated_min5\",\n  4248\t        !ever_china_top_observed ~ \"never_treated\",\n  4249\t        TRUE ~ \"excluded_short_or_ineligible\"\n  4250\t      ),\n  4251\t      first_treat = dplyr::if_else(\n  4252\t        cs_role_min5 == \"treated_min5\",\n  4253\t        as.numeric(first_qualifying_entry),\n  4254\t        0\n  4255\t      )\n  4256\t    )\n  4257\t\n  4258\t  list(\n  4259\t    period_panel = period_panel,\n  4260\t    period_summary = period_summary,\n  4261\t    qualifying_periods = qualifying_periods,\n  4262\t    unit_summary = unit_summary\n  4263\t  )\n  4264\t}\n  4265\t\n  4266\tbuild_min5_period_data <- build_status_current_period_data\n  4267\t\n  4268\tmake_status_current_panel <- function(period_data,\n  4269\t                                      require_balanced = TRUE,\n  4270\t                                      strict_never_control = FALSE,\n  4271\t                                      clean_single_spell = FALSE) {\n  4272\t  analysis_panel <- period_data$period_panel |>\n  4273\t    dplyr::left_join(\n  4274\t      period_data$qualifying_periods |>\n  4275\t        dplyr::mutate(qualifying_period = TRUE),\n  4276\t      by = c(\"iso3c\", \"eligible_period_id\")\n  4277\t    ) |>\n  4278\t    dplyr::mutate(\n  4279\t      qualifying_period = dplyr::coalesce(qualifying_period, FALSE),\n  4280\t      china_top = as.integer(qualifying_period)\n  4281\t    ) |>\n  4282\t    dplyr::left_join(\n  4283\t      period_data$unit_summary |>\n  4284\t        dplyr::select(\n  4285\t          iso3c,\n  4286\t          cs_role_min5,\n  4287\t          first_treat,\n  4288\t          first_qualifying_entry,\n  4289\t          eligible_periods,\n### make_status_current_panel (4268)\n  4268\tmake_status_current_panel <- function(period_data,\n  4269\t                                      require_balanced = TRUE,\n  4270\t                                      strict_never_control = FALSE,\n  4271\t                                      clean_single_spell = FALSE) {\n  4272\t  analysis_panel <- period_data$period_panel |>\n  4273\t    dplyr::left_join(\n  4274\t      period_data$qualifying_periods |>\n  4275\t        dplyr::mutate(qualifying_period = TRUE),\n  4276\t      by = c(\"iso3c\", \"eligible_period_id\")\n  4277\t    ) |>\n  4278\t    dplyr::mutate(\n  4279\t      qualifying_period = dplyr::coalesce(qualifying_period, FALSE),\n  4280\t      china_top = as.integer(qualifying_period)\n  4281\t    ) |>\n  4282\t    dplyr::left_join(\n  4283\t      period_data$unit_summary |>\n  4284\t        dplyr::select(\n  4285\t          iso3c,\n  4286\t          cs_role_min5,\n  4287\t          first_treat,\n  4288\t          first_qualifying_entry,\n  4289\t          eligible_periods,\n  4290\t          max_eligible_duration,\n  4291\t          total_eligible_china_top_years,\n  4292\t          total_qualifying_china_top_years,\n  4293\t          qualifying_periods,\n  4294\t          ever_china_top_observed\n  4295\t        ),\n  4296\t      by = \"iso3c\"\n  4297\t    ) |>\n  4298\t    dplyr::filter(cs_role_min5 %in% c(\"treated_min5\", \"never_treated\"))\n  4299\t\n  4300\t  if (clean_single_spell) {\n  4301\t    analysis_panel <- analysis_panel |>\n  4302\t      dplyr::filter(\n  4303\t        cs_role_min5 == \"never_treated\" |\n  4304\t          (\n  4305\t            cs_role_min5 == \"treated_min5\" &\n  4306\t              eligible_periods == 1L &\n  4307\t              qualifying_periods == 1L\n  4308\t          )\n  4309\t      )\n  4310\t  }\n  4311\t\n  4312\t  if (strict_never_control) {\n  4313\t    analysis_panel <- analysis_panel |>\n  4314\t      dplyr::filter(\n  4315\t        cs_role_min5 == \"never_treated\" |\n  4316\t          (\n  4317\t            cs_role_min5 == \"treated_min5\" &\n  4318\t              (\n  4319\t                qualifying_period |\n  4320\t                  (year < first_treat & china_top_eligible == 0L)\n  4321\t              )\n  4322\t          )\n  4323\t      )\n  4324\t\n  4325\t    analysis_panel <- analysis_panel |>\n  4326\t      dplyr::group_by(iso3c) |>\n  4327\t      dplyr::filter(sum(china_top == 0L, na.rm = TRUE) >= 5L) |>\n  4328\t      dplyr::ungroup()\n  4329\t  }\n  4330\t\n  4331\t  analysis_panel <- analysis_panel |>\n  4332\t    dplyr::select(\n  4333\t      -china_top_eligible,\n  4334\t      -eligible_period_start,\n  4335\t      -eligible_period_id_raw,\n  4336\t      -qualifying_period\n  4337\t    )\n  4338\t\n  4339\t  if (require_balanced) {\n  4340\t    max_years <- max(table(analysis_panel$iso3c))\n  4341\t    balanced_iso <- analysis_panel |>\n  4342\t      dplyr::group_by(iso3c) |>\n  4343\t      dplyr::summarise(n_years = dplyr::n(), .groups = \"drop\") |>\n  4344\t      dplyr::filter(n_years == max_years) |>\n  4345\t      dplyr::pull(iso3c)\n  4346\t\n  4347\t    analysis_panel <- analysis_panel |>\n  4348\t      dplyr::filter(iso3c %in% balanced_iso)\n  4349\t  }\n  4350\t\n  4351\t  panel_max <- max(analysis_panel$year, na.rm = TRUE)\n  4352\t  estimable_treated <- analysis_panel |>\n  4353\t    dplyr::filter(first_treat > 0, first_treat < panel_max, china_top == 1L) |>\n  4354\t    dplyr::distinct(iso3c) |>\n  4355\t    dplyr::pull(iso3c)\n  4356\t\n  4357\t  analysis_panel |>\n  4358\t    dplyr::filter(first_treat == 0 | iso3c %in% estimable_treated) |>\n  4359\t    dplyr::mutate(\n  4360\t      country_id = as.integer(as.factor(iso3c)),\n  4361\t      id = country_id\n  4362\t    ) |>\n  4363\t    dplyr::arrange(country_id, year) |>\n  4364\t    as.data.frame()\n  4365\t}\n  4366\t\n  4367\tcount_status_current_sample <- function(panel, label) {\n  4368\t  unit_status <- panel |>\n  4369\t    dplyr::arrange(iso3c, year) |>\n  4370\t    dplyr::group_by(iso3c, country_name) |>\n  4371\t    dplyr::summarise(\n  4372\t      ever_treated = any(china_top == 1L, na.rm = TRUE),\n  4373\t      treated_years = sum(china_top == 1L, na.rm = TRUE),\n  4374\t      untreated_years = sum(china_top == 0L, na.rm = TRUE),\n  4375\t      entries = sum(\n  4376\t        china_top == 1L &\n  4377\t          (is.na(dplyr::lag(china_top)) | dplyr::lag(china_top) == 0L),\n  4378\t        na.rm = TRUE\n  4379\t      ),\n  4380\t      exits = sum(\n  4381\t        china_top == 0L & dplyr::lag(china_top, default = 0L) == 1L,\n  4382\t        na.rm = TRUE\n  4383\t      ),\n  4384\t      first_treat_year = ifelse(\n  4385\t        ever_treated,\n  4386\t        min(year[china_top == 1L], na.rm = TRUE),\n  4387\t        NA_integer_\n  4388\t      ),\n  4389\t      .groups = \"drop\"\n  4390\t    )\n  4391\t\n  4392\t  tibble::tibble(\n  4393\t    sample = label,\n  4394\t    n_obs = nrow(panel),\n  4395\t    n_countries = dplyr::n_distinct(panel$iso3c),\n  4396\t    n_treated = sum(unit_status$ever_treated, na.rm = TRUE),\n  4397\t    n_control = sum(!unit_status$ever_treated, na.rm = TRUE),\n  4398\t    n_treated_country_years = sum(panel$china_top == 1L, na.rm = TRUE),\n  4399\t    n_untreated_country_years = sum(panel$china_top == 0L, na.rm = TRUE),\n  4400\t    n_entries = sum(unit_status$entries, na.rm = TRUE),\n  4401\t    n_exits = sum(unit_status$exits, na.rm = TRUE),\n  4402\t    panel_min = min(panel$year, na.rm = TRUE),\n  4403\t    panel_max = max(panel$year, na.rm = TRUE)\n  4404\t  )\n  4405\t}\n  4406\t\n  4407\tsummarize_status_current_units <- function(panel, label) {\n  4408\t  panel |>\n  4409\t    dplyr::group_by(iso3c, country_name, cs_role_min5) |>\n  4410\t    dplyr::summarise(\n  4411\t      sample = label,\n  4412\t      ever_treated = any(china_top == 1L, na.rm = TRUE),\n  4413\t      treated_years = sum(china_top == 1L, na.rm = TRUE),\n  4414\t      untreated_years = sum(china_top == 0L, na.rm = TRUE),\n  4415\t      first_treat = ifelse(\n  4416\t        any(china_top == 1L, na.rm = TRUE),\n  4417\t        min(year[china_top == 1L], na.rm = TRUE),\n  4418\t        NA_integer_\n  4419\t      ),\n  4420\t      first_year_in_panel = min(year, na.rm = TRUE),\n  4421\t      last_year_in_panel = max(year, na.rm = TRUE),\n  4422\t      .groups = \"drop\"\n  4423\t    ) |>\n  4424\t    dplyr::relocate(sample)\n  4425\t}\n  4426\t\n  4427\tmake_status_current_panel_bundle <- function(panel,\n  4428\t                                             duration_thresholds = c(3L, 5L, 7L),\n  4429\t                                             min_entry_year = 2000L) {\n  4430\t  duration_thresholds <- sort(unique(as.integer(duration_thresholds)))\n  4431\t  if (any(is.na(duration_thresholds)) || any(duration_thresholds <= 0L)) {\n  4432\t    stop(\"duration_thresholds must be positive integers.\", call. = FALSE)\n  4433\t  }\n  4434\t\n  4435\t  panels <- list()\n  4436\t  all_counts <- list()\n  4437\t  all_units <- list()\n  4438\t  all_periods <- list()\n### summarize_status_current_units (4407)\n  4407\tsummarize_status_current_units <- function(panel, label) {\n  4408\t  panel |>\n  4409\t    dplyr::group_by(iso3c, country_name, cs_role_min5) |>\n  4410\t    dplyr::summarise(\n  4411\t      sample = label,\n  4412\t      ever_treated = any(china_top =