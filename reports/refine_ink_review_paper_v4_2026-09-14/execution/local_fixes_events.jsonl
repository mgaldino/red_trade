 >= threshold,\n  4563\t        short_eligible_period = eligible_entry & duration_years < threshold,\n  4564\t        pre_min_entry_period = period_entry_year < min_entry_year,\n  4565\t        no_clean_prior_period = !pre_min_entry_period &\n  4566\t          (\n  4567\t            is.na(previous_trade_observed_at_entry) |\n  4568\t              previous_trade_observed_at_entry != TRUE |\n  4569\t              is.na(previous_china_is_top_at_entry) |\n  4570\t              previous_china_is_top_at_entry != FALSE\n  4571\t          )\n  4572\t      ) |>\n  4573\t      dplyr::group_by(iso3c, country_name) |>\n  4574\t      dplyr::summarise(\n  4575\t        n_observed_china_top_periods = dplyr::n(),\n  4576\t        n_qualifying_periods = sum(qualifying_period, na.rm = TRUE),\n  4577\t        n_short_eligible_periods = sum(short_eligible_period, na.rm = TRUE),\n  4578\t        n_pre_min_entry_periods = sum(pre_min_entry_period, na.rm = TRUE),\n  4579\t        n_no_clean_prior_periods = sum(no_clean_prior_period, na.rm = TRUE),\n  4580\t        longest_observed_china_top_period =\n  4581\t          max(duration_years, na.rm = TRUE),\n  4582\t        first_qualifying_entry =\n  4583\t          min_int_or_na(period_entry_year[qualifying_period]),\n  4584\t        .groups = \"drop\"\n  4585\t      )\n  4586\t\n  4587\t    base_units |>\n  4588\t      dplyr::left_join(period_counts, by = c(\"iso3c\", \"country_name\")) |>\n  4589\t      dplyr::mutate(\n  4590\t        min_duration_years = threshold,\n  4591\t        dplyr::across(\n  4592\t          c(\n  4593\t            n_observed_china_top_periods, n_qualifying_periods,\n  4594\t            n_short_eligible_periods, n_pre_min_entry_periods,\n  4595\t            n_no_clean_prior_periods\n  4596\t          ),\n  4597\t          ~ dplyr::coalesce(.x, 0L)\n  4598\t        ),\n  4599\t        longest_observed_china_top_period =\n  4600\t          dplyr::coalesce(longest_observed_china_top_period, 0L),\n  4601\t        audit_role = dplyr::case_when(\n  4602\t          n_qualifying_periods > 0L ~ \"treated_qualifying\",\n  4603\t          !ever_observed_china_top ~ \"never_china_top_control\",\n  4604\t          n_pre_min_entry_periods > 0L &\n  4605\t            n_short_eligible_periods == 0L &\n  4606\t            n_no_clean_prior_periods == 0L ~ \"excluded_pre_2000\",\n  4607\t          n_no_clean_prior_periods > 0L &\n  4608\t            n_short_eligible_periods == 0L ~ \"excluded_no_clean_prior\",\n  4609\t          n_short_eligible_periods > 0L ~ \"excluded_short_duration\",\n  4610\t          TRUE ~ \"excluded_other_nonqualifying\"\n  4611\t        ),\n  4612\t        .before = iso3c\n  4613\t      )\n  4614\t  })\n  4615\t\n  4616\t  dplyr::bind_rows(threshold_audit) |>\n  4617\t    dplyr::arrange(min_duration_years, audit_role, iso3c)\n  4618\t}\n  4619\t\n  4620\tstatus_current_spec_label <- function(specification) {\n  4621\t  dplyr::recode(\n  4622\t    specification,\n  4623\t    switching_allowed = \"Status-current, switching allowed\",\n  4624\t    risk_set_restricted = \"Status-current, restricted risk set\",\n  4625\t    clean_single_spell = \"Clean single-entry robustness\",\n  4626\t    .default = specification\n  4627\t  )\n  4628\t}\n  4629\t\n  4630\tfit_status_current_fect_models <- function(panel_bundle,\n  4631\t                                           nboots = 10000L,\n  4632\t                                           metric = \"m2_goods_exports_itpde\",\n  4633\t                                           metric_label = \"M2 goods-only: ITPD-E export destinations\") {\n  4634\t  if (is.na(nboots) || nboots <= 0L) {\n  4635\t    stop(\"nboots must be a positive integer.\", call. = FALSE)\n  4636\t  }\n  4637\t\n  4638\t  all_model_results <- list()\n  4639\t  all_dynamic <- list()\n  4640\t  main_fit <- NULL\n  4641\t\n  4642\t  for (duration_name in names(panel_bundle$panels)) {\n  4643\t    duration_years <- as.integer(duration_name)\n  4644\t    spec_panels <- panel_bundle$panels[[duration_name]]\n  4645\t\n  4646\t    for (specification in names(spec_panels)) {\n  4647\t      panel <- spec_panels[[specification]]\n  4648\t      timing <- system.time({\n  4649\t        fit <- run_fect_analysis(\n  4650\t          panel,\n  4651\t          method = \"ife\",\n  4652\t          nboots = nboots,\n  4653\t          fml = abs_distance_china ~ china_top\n  4654\t        )\n  4655\t      })\n  4656\t\n  4657\t      key <- paste(duration_years, specification, sep = \"_\")\n  4658\t\n  4659\t      all_model_results[[key]] <- summarize_fect_model(\n  4660\t        fit,\n  4661\t        panel,\n  4662\t        fml = abs_distance_china ~ china_top\n  4663\t      ) |>\n  4664\t        tibble::as_tibble() |>\n  4665\t        dplyr::mutate(\n  4666\t          metric = metric,\n  4667\t          metric_label = metric_label,\n  4668\t          min_duration_years = duration_years,\n  4669\t          specification = specification,\n  4670\t          specification_label = status_current_spec_label(specification),\n  4671\t          nboots = nboots,\n  4672\t          elapsed_seconds = as.numeric(timing[[\"elapsed\"]]),\n  4673\t          .before = att\n  4674\t        )\n  4675\t\n  4676\t      all_dynamic[[key]] <- tibble::tibble(\n  4677\t        metric = metric,\n  4678\t        min_duration_years = duration_years,\n  4679\t        specification = specification,\n  4680\t        event_time = fit$time,\n  4681\t        count = fit$count,\n  4682\t        att = as.numeric(fit$est.att[, 1]),\n  4683\t        se = as.numeric(fit$est.att[, 2])\n  4684\t      ) |>\n  4685\t        dplyr::mutate(\n  4686\t          ci_lo = att - 1.96 * se,\n  4687\t          ci_hi = att + 1.96 * se\n  4688\t        )\n  4689\t\n  4690\t      if (duration_years == 5L && specification == \"risk_set_restricted\") {\n  4691\t        main_fit <- fit\n  4692\t      }\n  4693\t    }\n  4694\t  }\n  4695\t\n  4696\t  model_results <- dplyr::bind_rows(all_model_results) |>\n  4697\t    dplyr::mutate(\n  4698\t      specification_order = dplyr::case_when(\n  4699\t        specification == \"risk_set_restricted\" ~ 1L,\n  4700\t        specification == \"clean_single_spell\" ~ 2L,\n  4701\t        specification == \"switching_allowed\" ~ 3L,\n  4702\t        TRUE ~ 99L\n  4703\t      )\n  4704\t    ) |>\n  4705\t    dplyr::arrange(min_duration_years, specification_order) |>\n  4706\t    dplyr::select(-specification_order)\n  4707\t\n  4708\t  dynamic_results <- dplyr::bind_rows(all_dynamic) |>\n  4709\t    dplyr::arrange(min_duration_years, specification, event_time)\n  4710\t\n  4711\t  list(\n  4712\t    model_results = model_results,\n  4713\t    dynamic_results = dynamic_results,\n  4714\t    main_fit = main_fit\n  4715\t  )\n  4716\t}\n  4717\t\n  4718\tplot_status_current_dynamic <- function(dynamic_data,\n  4719\t                                        min_duration_years = 5L,\n  4720\t                                        specification = \"risk_set_restricted\") {\n  4721\t  plot_data <- dynamic_data |>\n  4722\t    dplyr::filter(\n  4723\t      min_duration_years == .env$min_duration_years,\n  4724\t      specification == .env$specification,\n  4725\t      !is.na(att),\n  4726\t      !is.na(se)\n  4727\t    )\n  4728\t\n  4729\t  ggplot2::ggplot(plot_data, ggplot2::aes(x = event_time, y = att)) +\n  4730\t    ggplot2::geom_hline(\n  4731\t      yintercept = 0,\n  4732\t      linewidth = 0.35,\n  4733\t      linetype = \"dashed\",\n  4734\t      color = \"grey45\"\n  4735\t    ) +\n  4736\t    ggplot2::geom_ribbon(\n  4737\t      ggplot2::aes(ymin = ci_lo, ymax = ci_hi),\n  4738\t      fill = \"#9bb7d4\",\n  4739\t      alpha = 0.32,\n  4740\t      color = NA\n  4741\t    ) +\n  4742\t    ggplot2::geom_line(linewidth = 0.65, color = \"#1f4e79\") +\n  4743\t    ggplot2::geom_point(size = 1.8, color = \"#1f4e79\") +\n  4744\t    ggplot2::labs(\n  4745\t      x = \"Periods relative to China #1 entry\",\n  4746\t      y = \"Effect on UNGA ideal-point distance to China\"\n  4747\t    ) +\n  4748\t    ggplot2::theme_minimal(base_size = 11) +\n  4749\t    ggplot2::theme(\n  4750\t      panel.grid.minor = ggplot2::element_blank(),\n  4751\t      plot.title = ggplot2::element_blank()\n  4752\t    )\n  4753\t}\n  4754\t\n  4755\t# Dispersion of treatment entry years across the cross-country treated units.\n  4756\t# The figure answers a specific objection to the design: Brazil's 2009 entry is\n  4757\t# endogenous to the global financial crisis, so a reader may suspect that the\n--- existing 2026-05-20 period/unit summaries ---\n### data/processed/diagnostics/china_top_m2_goods_status_current_min5/m2_goods_status_current_min_duration_period_summary_2026-05-20.csv\nmin_duration_years,iso3c,country_name,eligible_period_id,period_entry_year,period_exit_year,duration_years,calendar_span_years,qualifies_min5\n3,AGO,Angola,1,2007,2022,16,16,TRUE\n3,ARM,Armenia,1,2015,2015,1,1,FALSE\n3,ARM,Armenia,2,2020,2021,2,2,FALSE\n3,AUS,Australia,1,2009,2022,14,14,TRUE\n3,BEN,Benin,1,2004,2004,1,1,FALSE\n3,BEN,Benin,2,2008,2008,1,1,FALSE\n3,BEN,Benin,3,2012,2013,2,2,FALSE\n3,BFA,Burkina Faso,1,2005,2007,3,3,TRUE\n3,BRA,Brazil,1,2009,2022,14,14,TRUE\n3,CAF,Central African Republic,1,2013,2014,2,2,FALSE\n3,CAF,Central African Republic,2,2018,2018,1,1,FALSE\n### data/processed/diagnostics/china_top_m2_goods_status_current_min5/m2_goods_status_current_min_duration_unit_summary_2026-05-20.csv\nmin_duration_years,sample,iso3c,country_name,cs_role_min5,ever_treated,treated_years,untreated_years,first_treat,first_year_in_panel,last_year_in_panel\n3,clean_single_spell,AFG,Afghanistan,never_treated,FALSE,0,33,,1990,2022\n3,clean_single_spell,AGO,Angola,treated_min5,TRUE,16,17,2007,1990,2022\n3,clean_single_spell,ALB,Albania,never_treated,FALSE,0,33,,1990,2022\n3,clean_single_spell,AND,Andorra,never_treated,FALSE,0,30,,1993,2022\n3,clean_single_spell,ARE,United Arab Emirates,never_treated,FALSE,0,33,,1990,2022\n3,clean