  "orchestration_plan": {
    "implementation": {
      "model": "gpt-5.6-sol",
      "effort": "high"
    },
    "review": {
      "model": "gpt-5.6-sol",
      "effort": "high",
      "must_be_independent": true,
      "review_mode": "independent"
    }
  },
  "codex_command": [
    "codex",
    "exec",
    "--ephemeral",
    "--model",
    "gpt-5.6-sol",
    "-c",
    "model_reasoning_effort=\"high\"",
    "-"
  ]
}
