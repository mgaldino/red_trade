# History files
.Rhistory
.Rapp.history

# Session Data files
.RData
.RDataTmp

# User-specific files
.Ruserdata

# Example code in package build process
*-Ex.R

# Output files from R CMD build
/*.tar.gz

# Output files from R CMD check
/*.Rcheck/

# RStudio files
.Rproj.user/

# produced vignettes
vignettes/*.html
vignettes/*.pdf

# OAuth2 token, see https://github.com/hadley/httr/releases/tag/v0.3
.httr-oauth

# knitr and R markdown default cache directories
*_cache/
/cache/

# Temporary files created by R markdown
*.utf8.md
*.knit.md

# R Environment Variables
.Renviron

# pkgdown site
docs/

# translation temp files
po/*~

# RStudio Connect folder
rsconnect/
raw data/
raw_data_20250708.zip
.DS_Store

# Local-only directories (not for repo)
references/
replication package/
quality_reports/
presentations/

# Private editorial/reviewer correspondence
reports/*decision_reviews*.md

# Large local datasets and generated diagnostics (preserved on disk, not versioned)
data/raw/batis_bpm5/
data/raw/batis_bpm6/
data/raw/mechanism_evidence_china_2009_2011/falabr/Arquivos_csv_*.zip
data/processed/diagnostics/china_top_goods_services/china_top_goods_services_country_year_partner_*.csv
data/processed/diagnostics/china_top_goods_services/china_top_goods_services_rank_long_*.csv

# Smoke-test placebo checkpoints (low replication counts): caches, never deliverables.
data/processed/diagnostics/*/checkpoints/placebo_se_*_[0-9].rds
data/processed/diagnostics/*/checkpoints/placebo_se_*_[0-9][0-9].rds

# Rebuild batch state and logs: machine-local run bookkeeping, never shared.
# A versioned STATE.tsv makes a replicator skip the renv restore and the donor
# pool gate, because run_rebuild_batch.sh reads it as "already done".
output/rebuild_batches/
